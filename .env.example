# SMTP credentials used by /api/contact to send you the contact form messages.
# For Gmail: enable 2FA on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASS below.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sample@gmail.com
SMTP_PASS=your-16-character-app-password
CONTACT_TO_EMAIL=sample@gmail.com
